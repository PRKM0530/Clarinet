# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./clarinet.db

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Network (set these on Linux deployment) ────────────────────────────────────
# NETWORK_INTERFACE=      # leave unset: Clarinet finds the connection to your router by itself
NETWORK_MODE=MONITOR          # FULL | MONITOR
ACTIVE_DISCOVERY=auto         # auto (Full Control only) | on | off: ARP scan of the subnet, needs root

# ── ISP Plan ───────────────────────────────────────────────────────────────────
PLAN_DOWNLOAD_MBPS=100
PLAN_UPLOAD_MBPS=20
BILLING_DAY=1                 # day of month billing resets

# ── Thresholds ─────────────────────────────────────────────────────────────────
SLOWDOWN_LATENCY_MULTIPLIER=3.0
SLOWDOWN_SPEED_THRESHOLD=0.70  # below 70% of plan = slowdown
ALERT_LOCKOUT_ATTEMPTS=5
ALERT_LOCKOUT_MINUTES=5

# Reverse proxies whose X-Forwarded-For header may be trusted (comma separated)
TRUSTED_PROXIES=127.0.0.1,::1
# Send the session cookie over HTTPS only. Set true when serving through Caddy
COOKIE_SECURE=false
