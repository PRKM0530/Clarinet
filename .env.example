# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./clarinet.db

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Network (set these on Linux deployment) ────────────────────────────────────
NETWORK_INTERFACE=eth0
NETWORK_MODE=MONITOR          # FULL | MONITOR | PUBLIC

# ── ISP Plan ───────────────────────────────────────────────────────────────────
PLAN_DOWNLOAD_MBPS=100
PLAN_UPLOAD_MBPS=20
BILLING_DAY=1                 # day of month billing resets

# ── Thresholds ─────────────────────────────────────────────────────────────────
SLOWDOWN_LATENCY_MULTIPLIER=3.0
SLOWDOWN_SPEED_THRESHOLD=0.70  # below 70% of plan = slowdown
ALERT_LOCKOUT_ATTEMPTS=5
ALERT_LOCKOUT_MINUTES=5
SESSION_IDLE_MINUTES=30
